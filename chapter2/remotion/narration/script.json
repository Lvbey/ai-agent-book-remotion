    {
      "sceneKey": "StateBar",
      "reviewStatus": "implementation-reviewed",
      "units": [
        {
          "id": "09-01",
          "text": "多轮执行后，模型可能需要从长历史里重新推断目标、计数、已完成工作和下一步。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "09-02",
          "text": "状态栏把这些信息显式记录下来。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "09-03",
          "text": "它可以由代码确定性更新，也可以由模型整理；无论哪种方式，关键状态都应验证，因为错误状态会误导后续决策。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "09-04",
          "text": "位置也是工程取舍：把不断变化的状态放在稳定前缀前面，可能影响缓存；追加到后面更利于保留前缀，但仍要确保模型能读到最新状态。",
          "delivery": "explain",
          "visualCues": []
        }
      ],
