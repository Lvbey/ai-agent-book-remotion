    {
      "sceneKey": "ContextMap",
      "reviewStatus": "implementation-reviewed",
      "units": [
        {
          "id": "02-01",
          "text": "上下文，就是模型在这一次决策时实际收到的信息。",
          "delivery": "explain",
          "visualCues": [
            {
              "phrase": "上下文，就是模型",
              "action": "对应机制推进，待真实时间戳绑定"
            }
          ]
        },
        {
          "id": "02-02",
          "text": "它不只有聊天记录，还包括开发者规则、当前任务、此前的助手行动、工具说明和工具返回的观察。",
          "delivery": "explain",
          "visualCues": [
            {
              "phrase": "它不只有聊天记录",
              "action": "对应机制推进，待真实时间戳绑定"
            }
          ]
        },
        {
          "id": "02-03",
          "text": "模型提供通用能力，上下文负责提供地图、路况和任务约束。",
          "delivery": "explain",
          "visualCues": [
            {
              "phrase": "模型提供通用能力",
              "action": "对应机制推进，待真实时间戳绑定"
            }
          ]
        },
        {
          "id": "02-04",
          "text": "资料多并不自动代表更好，关键是相关信息是否完整、可信、容易找到。",
          "delivery": "explain",
          "visualCues": [
            {
              "phrase": "资料多并不自动代",
              "action": "对应机制推进，待真实时间戳绑定"
            }
          ]
