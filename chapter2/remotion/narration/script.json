    {
      "sceneKey": "PromptAndSafety",
      "reviewStatus": "implementation-reviewed",
      "units": [
        {
          "id": "08-01",
          "text": "Skill 把领域流程写成按需加载的说明：先看目录，需要时再打开细节。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "08-02",
          "text": "Skill 不等于工具，也不会自动授予权限。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "08-03",
          "text": "网页或文件可能包含伪装成命令的提示注入，应作为不可信数据处理。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "08-04",
          "text": "安全还依赖最小权限、参数校验、危险操作确认和结果审计。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "08-05",
          "text": "编写技能时，应写清适用条件、操作步骤、验证和失败处理。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "08-06",
          "text": "目录只提供发现入口，具体流程在触发后加载，执行仍要依赖真实工具和权限。",
          "delivery": "explain",
          "visualCues": []
        }
      ],
