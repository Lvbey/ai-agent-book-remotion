    {
      "sceneKey": "PromptEngineering",
      "reviewStatus": "implementation-reviewed",
      "units": [
        {
          "id": "07-01",
          "text": "系统提示词需要组织目标、流程、业务规则、输出格式和边界，而不是不断追加互相冲突的要求。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "07-02",
          "text": "抽象规则难以说明时，可以给出输入和理想输出作为 Few-shot 示例；工具描述也要准确表达用途、参数和限制。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "07-03",
          "text": "原文消融实验说明组织质量会影响任务表现，但特定实验结果不是所有系统的固定保证。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "07-04",
          "text": "例如，同一段提示同时要求解释所有细节又绝对简短，就需要明确优先级。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "07-05",
          "text": "示例应覆盖有代表性的输入，而不是越堆越多。",
          "delivery": "explain",
          "visualCues": []
        }
      ],
