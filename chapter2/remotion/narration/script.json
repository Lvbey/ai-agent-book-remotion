      "sceneKey": "SubAgentIsolation",
      "reviewStatus": "implementation-reviewed",
      "units": [
        {
          "id": "12-01",
          "text": "另一个办法是让子 Agent 在独立上下文中完成大量探索，只回传路径、结论和证据。",
          "delivery": "explain",
          "visualCues": []
        },
        {
