    {
      "sceneKey": "ApiStructure",
      "reviewStatus": "implementation-reviewed",
      "units": [
        {
          "id": "03-01",
          "text": "常见聊天 API 中，system 放开发者规则，user 放用户任务，assistant 是模型此前的回复或工具调用请求，tool 是框架执行工具后返回的结果。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "03-02",
          "text": "工具定义通常单独放在 tools 字段，并不是第五种消息角色。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "03-03",
          "text": "例如，天气工具需要城市和温度单位；模型依据名称、描述和参数约束构造调用。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "03-04",
          "text": "收到调用请求之后，真正访问外部服务的是框架，而不是模型自己。",
          "delivery": "explain",
          "visualCues": []
        }
      ],
      "anchors": [
        {
          "phrase": "常见",
