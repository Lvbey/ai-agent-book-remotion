    {
      "sceneKey": "StateAndCompress",
      "reviewStatus": "implementation-reviewed",
      "units": [
        {
          "id": "10-01",
          "text": "压缩有三个动机：控制窗口和成本；把原始记录中的结论整理成容易检索的知识；降低模型因上下文将满而提前收尾的风险。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "10-02",
          "text": "上下文溢出是装不下；Context Rot 是装得下，却因内容过长、过杂而难以找到重点。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "10-03",
          "text": "摘要是有损投影，必须保留后续决策需要的事实、约束、失败路径、时间和来源。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "10-04",
          "text": "例如，把去年的测试结论压缩成系统已经安全，就丢掉了时间和证据范围。",
          "delivery": "explain",
          "visualCues": []
        },
        {
          "id": "10-05",
          "text": "摘要需要保留什么时候、在哪个环境、用什么证据得出的结论。",
          "delivery": "explain",
          "visualCues": []
        }
      ],
