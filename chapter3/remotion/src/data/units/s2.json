[
  {
    "id": "EP01-U019",
    "scene": "EvalFrame",
    "title": "先立评估标准",
    "kp": ["EVAL-001"],
    "text": "在动手设计之前，先要回答一个问题：什么样的记忆系统才算好？先确立评估标准，后面讨论各种设计方案时，才有统一的标尺。",
    "steps": [
      {"kind": "note", "label": "设计之前先定标尺"},
      {"kind": "axis", "label": "评估标准 → 设计方案", "v": "0.2"}
    ]
  },
  {
    "id": "EP01-U020",
    "scene": "EvalFrame",
    "title": "LoCoMo 基准",
    "kp": ["EVAL-002"],
    "text": "学术界已经发布了若干公开基准，其中 LoCoMo 比较有代表性。它构造了平均约三百轮、最多三十五个会话的超长多轮对话。",
    "steps": [
      {"kind": "bench", "label": "LoCoMo · 长期对话记忆"},
      {"kind": "stat", "label": "平均约 300 轮", "v": "300"},
      {"kind": "stat", "label": "最多 35 个会话", "v": "35"}
    ]
  },
  {
    "id": "EP01-U021",
    "scene": "EvalFrame",
    "title": "LoCoMo 的三类任务",
    "kp": ["EVAL-003"],
    "text": "它通过三类任务来考察模型：问答、事件摘要，以及多模态对话生成。其中问答又细分为单跳、多跳、时间推理、开放域和对抗性问题。",
    "steps": [
      {"kind": "task", "label": "问答"},
      {"kind": "task", "label": "单跳 · 多跳"},
      {"kind": "task", "label": "时间推理 · 开放域 · 对抗性"},
      {"kind": "task", "label": "事件摘要"},
      {"kind": "task", "label": "多模态对话生成"}
    ]
  },
  {
    "id": "EP01-U022",
    "scene": "EvalFrame",
    "title": "八项能力的归纳口径",
    "kp": ["EVAL-004", "EVAL-005"],
    "text": "综合 LoCoMo 这类基准和商业记忆产品的实践，用户记忆能力可以归纳为八项。请注意，这是笔者的归纳口径，不是某一个基准的原始分类。",
    "steps": [
      {"kind": "note", "label": "八项能力 = 笔者归纳口径"},
      {"kind": "grid", "label": "8 项能力网格"}
    ]
  },
  {
    "id": "EP01-U023",
    "scene": "EvalFrame",
    "title": "八项能力：前四项",
    "kp": ["EVAL-004"],
    "text": "前四项是：个人信息保留，记住身份等长期信息；偏好追踪，跟踪长期偏好；上下文切换，在多个话题之间保持连贯；记忆更新，遇到矛盾的新信息时能正确处理。",
    "steps": [
      {"kind": "ability", "label": "个人信息保留", "v": "记住身份等长期信息"},
      {"kind": "ability", "label": "偏好追踪", "v": "跟踪长期偏好"},
      {"kind": "ability", "label": "上下文切换", "v": "多话题之间保持连贯"},
      {"kind": "ability", "label": "记忆更新", "v": "矛盾的新信息能正确处理"}
    ]
  },
  {
    "id": "EP01-U024",
    "scene": "EvalFrame",
    "title": "八项能力：后四项",
    "kp": ["EVAL-004"],
    "text": "后四项是：多会话连续性；复杂思考，比如知道用户对花生过敏，推荐泰国菜时要主动提醒花生成分；时间感知；以及冲突解决。",
    "steps": [
      {"kind": "ability", "label": "多会话连续性", "v": "跨会话保持知识"},
      {"kind": "ability", "label": "复杂思考", "v": "多记忆片段联合推理"},
      {"kind": "ability", "label": "时间感知", "v": "日期、相对时间、时间计算"},
      {"kind": "ability", "label": "冲突解决", "v": "识别并处理不一致"}
    ]
  },
  {
    "id": "EP01-U025",
    "scene": "EvalFrame",
    "title": "复杂思考的例子",
    "kp": ["EVAL-004"],
    "text": "复杂思考这个例子值得展开：用户说想吃泰国菜，系统要能联想到花生过敏这条记忆，主动提示注意花生成分。这是跨记忆片段的联合推理。",
    "steps": [
      {"kind": "case", "label": "用户想吃泰国菜"},
      {"kind": "case", "label": "检索到：花生过敏"},
      {"kind": "case", "label": "主动提醒注意花生成分"}
    ]
  },
  {
    "id": "EP01-U026",
    "scene": "EvalFrame",
    "title": "三层次框架：第一层",
    "kp": ["EVAL-006"],
    "text": "在此基础上，我们设计了更贴合 Agent 场景的三层次评估框架，把记忆能力分成三个递进的层级。最底层是基础回忆。",
    "steps": [
      {"kind": "layer", "label": "第一层 · 基础回忆", "v": "1"},
      {"kind": "axis", "label": "递进层级", "v": "0.33"}
    ]
  },
  {
    "id": "EP01-U027",
    "scene": "EvalFrame",
    "title": "第一层的判定",
    "kp": ["EVAL-006"],
    "text": "基础回忆要求 Agent 准确存储和检索用户直接提供的、结构化的、无歧义的信息。比如用户说我的会员号是 12345，下次需要时要能精确返回。",
    "steps": [
      {"kind": "case", "label": "我的会员号是 12345"},
      {"kind": "case", "label": "后续提问：我的会员号是多少？"},
      {"kind": "score", "label": "精确返回 12345", "v": "1"}
    ]
  },
  {
    "id": "EP01-U028",
    "scene": "EvalFrame",
    "title": "三层次框架：第二层",
    "kp": ["EVAL-007"],
    "text": "第二层是多会话检索：面对来自不同对象、不同时期的多段会话，要能检索出所有相关信息，并在此基础上推理判断。",
    "steps": [
      {"kind": "layer", "label": "第二层 · 多会话检索", "v": "2"},
      {"kind": "axis", "label": "递进层级", "v": "0.66"}
    ]
  },
  {
    "id": "EP01-U029",
    "scene": "EvalFrame",
    "title": "第二层例子：两辆车",
    "kp": ["EVAL-007"],
    "text": "第一个例子：用户有两辆车，他说给我的车预约保养。系统要找出两辆车的全部信息，并主动询问是哪一辆，而不是随便猜一辆。",
    "steps": [
      {"kind": "case", "label": "会话 A：登记了 A 车"},
      {"kind": "case", "label": "会话 B：登记了 B 车"},
      {"kind": "case", "label": "为我的车预约保养"},
      {"kind": "score", "label": "主动询问是哪一辆", "v": "2"}
    ]
  },
  {
    "id": "EP01-U030",
    "scene": "EvalFrame",
    "title": "第二层例子：贷款状态",
    "kp": ["EVAL-007"],
    "text": "第二个例子：询问贷款状态时，系统要能分辨正在履行的有效合同，忽略过去咨询过、但并没有生效的报价。",
    "steps": [
      {"kind": "case", "label": "曾咨询的报价（未生效）"},
      {"kind": "case", "label": "正在履行的有效合同"},
      {"kind": "score", "label": "只采纳有效合同", "v": "2"}
    ]
  },
  {
    "id": "EP01-U031",
    "scene": "EvalFrame",
    "title": "第二层例子：洛杉矶之旅",
    "kp": ["EVAL-007"],
    "text": "第三个例子：取消洛杉矶之旅时，系统要理解旅行是一个复合事件，主动关联机票、酒店等所有相关预订，而不是只取消其中一项。",
    "steps": [
      {"kind": "case", "label": "复合事件：洛杉矶之旅"},
      {"kind": "case", "label": "关联机票预订"},
      {"kind": "case", "label": "关联酒店预订"}
    ]
  },
  {
    "id": "EP01-U032",
    "scene": "EvalFrame",
    "title": "三层次框架：第三层",
    "kp": ["EVAL-008"],
    "text": "第三层是主动服务，这是衡量 Agent 是否达到助理水准的最高标准：综合多个会话、甚至很久以前的信息，提供具有预见性的主动帮助。",
    "steps": [
      {"kind": "layer", "label": "第三层 · 主动服务", "v": "3"},
      {"kind": "axis", "label": "递进层级", "v": "1"}
    ]
  },
  {
    "id": "EP01-U033",
    "scene": "EvalFrame",
    "title": "第三层例子：护照预警",
    "kp": ["EVAL-008"],
    "text": "预订国际航班时，主动关联数月前存储的护照信息，发现即将过期并发出预警。注意，用户并没有要求它去检查护照。",
    "steps": [
      {"kind": "case", "label": "数月前：存储护照信息"},
      {"kind": "case", "label": "现在：预订国际航班"},
      {"kind": "score", "label": "主动预警护照即将过期", "v": "3"}
    ]
  },
  {
    "id": "EP01-U034",
    "scene": "EvalFrame",
    "title": "第三层例子：手机损坏",
    "kp": ["EVAL-008"],
    "text": "手机损坏时，主动整合所有保障方案：手机自带的保修、信用卡附加的保修条款、运营商的保险，给用户一份完整的解决方案选项列表。",
    "steps": [
      {"kind": "case", "label": "手机自带保修"},
      {"kind": "case", "label": "信用卡附加保修条款"},
      {"kind": "case", "label": "运营商保险"},
      {"kind": "score", "label": "整合为完整方案列表", "v": "3"}
    ]
  },
  {
    "id": "EP01-U035",
    "scene": "EvalFrame",
    "title": "第三层例子：报税季",
    "kp": ["EVAL-008"],
    "text": "报税季主动从过去一年的记录里搜寻并整合所有税务文件：股票销售、自由职业收入、房产税，呈现一份完整的待办清单。",
    "steps": [
      {"kind": "case", "label": "股票销售记录"},
      {"kind": "case", "label": "自由职业收入"},
      {"kind": "case", "label": "房产税"},
      {"kind": "score", "label": "整合为完整待办清单", "v": "3"}
    ]
  },
  {
    "id": "EP01-U036",
    "scene": "EvalFrame",
    "title": "主动服务的本质",
    "kp": ["EVAL-008"],
    "text": "这种能力的关键在于：在没有明确指令的情况下，主动规避潜在问题、整合复杂信息。它也因此成为三层里最难的一层。",
    "steps": [
      {"kind": "note", "label": "无明确指令 → 主动规避 + 主动整合"},
      {"kind": "axis", "label": "难度", "v": "1"}
    ]
  },
  {
    "id": "EP01-U037",
    "scene": "EvalFrame",
    "title": "框架贯穿全章",
    "kp": ["EVAL-009"],
    "text": "这个三层次框架会贯穿本章。后面的实验 3-9 和实验 3-11，都会用它来衡量检索技术对记忆能力的提升。",
    "steps": [
      {"kind": "note", "label": "实验 3-9：智能体化 RAG"},
      {"kind": "note", "label": "实验 3-11：上下文感知检索"}
    ]
  },
  {
    "id": "EP01-U038",
    "scene": "EvalFrame",
    "title": "实验 3-1：评估集规模",
    "kp": ["EVAL-010"],
    "text": "实验 3-1 就是按这个框架构建评估集：每层各二十个测试用例，每个用例包含大量事实细节。第一层的用例通常由单个会话构成。",
    "steps": [
      {"kind": "exp", "label": "第一层 · 20 个用例", "v": "单会话"},
      {"kind": "exp", "label": "第二层 · 20 个用例", "v": "多会话"},
      {"kind": "exp", "label": "第三层 · 20 个用例", "v": "多会话"}
    ]
  },
  {
    "id": "EP01-U039",
    "scene": "EvalFrame",
    "title": "实验 3-1：用例结构",
    "kp": ["EVAL-010"],
    "text": "第二层和第三层的用例，则由多个跨时间、跨对象的会话构成，每个用例合计大约五十轮沟通。信息分散在这么多轮里，才是难点。",
    "steps": [
      {"kind": "exp", "label": "跨时间会话"},
      {"kind": "exp", "label": "跨对象会话"},
      {"kind": "stat", "label": "每用例约 50 轮", "v": "50"}
    ]
  },
  {
    "id": "EP01-U040",
    "scene": "EvalFrame",
    "title": "实验 3-1：记忆生成与修改",
    "kp": ["EVAL-011"],
    "text": "评估时要求被测 Agent 先根据第一个会话生成记忆，再根据记忆和下一个会话修改记忆。关键限制是：它只能访问记忆，不能回看之前的原始对话。",
    "steps": [
      {"kind": "exp", "label": "会话 1 → 生成记忆"},
      {"kind": "exp", "label": "会话 2 → 修改记忆"},
      {"kind": "note", "label": "限制：不可回看原始对话"}
    ]
  },
  {
    "id": "EP01-U041",
    "scene": "EvalFrame",
    "title": "实验 3-1：新问答",
    "kp": ["EVAL-012"],
    "text": "所有会话处理完、记忆生成完毕后，再用一个新的用户问题去问它，要求它只依据记忆作答。此时原始对话已经完全不可见。",
    "steps": [
      {"kind": "exp", "label": "所有会话处理完毕"},
      {"kind": "exp", "label": "新用户问题 → 仅依据记忆作答"}
    ]
  },
  {
    "id": "EP01-U042",
    "scene": "EvalFrame",
    "title": "实验 3-1：LLM-as-a-judge",
    "kp": ["EVAL-012"],
    "text": "评分采用 LLM-as-a-judge，也就是让另一个 LLM 来当评委，把回答和参考答案做对比，给出该测试用例的奖励得分。",
    "steps": [
      {"kind": "exp", "label": "评委 LLM"},
      {"kind": "exp", "label": "回答 vs 参考答案"},
      {"kind": "score", "label": "奖励得分", "v": "0.86"}
    ]
  },
